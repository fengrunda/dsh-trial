#!/usr/bin/env python3
"""dsh-trial — start/stop the trial broker daemon; observe & tune goals.

start / stop wrap broker/start.sh and broker/stop.sh (do not reinvent the daemon).
status / goals list thin-state goals. broker-status prints pid/inbox (trial-broker.py --status).
Desk (dsh web) is the human UX; this CLI is not a second inbox writer.
Never touches broker-khub-prod.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent


def _broker_candidates() -> list[Path]:
    rows: list[Path] = []
    if os.environ.get("DSH_TRIAL_ROOT"):
        rows.append(Path(os.environ["DSH_TRIAL_ROOT"]) / "broker")
    rows.append(_HERE.parent / "broker")
    rows.append(Path("/workspace/dsh-trial/broker"))  # legacy box default
    return rows


def broker_dir() -> Path:
    for b in _broker_candidates():
        if (b / "trial_lib.py").is_file() or (b / "start.sh").is_file():
            return b
    return _HERE.parent / "broker"


def _ensure_trial_lib() -> Path:
    found = None
    for b in _broker_candidates():
        if (b / "trial_lib.py").is_file():
            found = b
            break
    if found is None:
        found = _HERE.parent / "broker"
    inserted = str(found)
    if inserted not in sys.path:
        sys.path.insert(0, inserted)
    return found


def cmd_status(args: argparse.Namespace) -> int:
    _ensure_trial_lib()
    from trial_lib import (  # noqa: E402
        GOALS,
        heartbeat_summary,
        max_concurrent_goals,
        read_broker_heartbeat,
    )

    if args.goal:
        path = GOALS / f"{args.goal}.json"
        if not path.is_file():
            print(f"goal not found: {path}", file=sys.stderr)
            return 1
        data = json.loads(path.read_text(encoding="utf-8"))
        if args.json:
            print(json.dumps(data, ensure_ascii=False, indent=2))
            return 0
        print(f"goal={data.get('goal')} status={data.get('status')}")
        print(f"slices={data.get('slices')} supervisor_tickets={data.get('supervisor_ticket_count')}")
        print(f"limits_effective={json.dumps(data.get('limits_effective'), ensure_ascii=False)}")
        print(f"limits_sources={json.dumps(data.get('limits_sources'), ensure_ascii=False)}")
        if data.get("limit_hit"):
            print(f"limit_hit={json.dumps(data.get('limit_hit'), ensure_ascii=False)}")
        m = data.get("metrics") or {}
        print(
            f"metrics: holds={m.get('hold_count')} rework={m.get('rework_rounds')} "
            f"asks={m.get('ask_count')} prompt_token_total={m.get('prompt_token_total')}"
        )
        for t in m.get("tickets") or []:
            print(
                f"  - {t.get('role')} {t.get('ticket')} peak={t.get('peak_prompt')} "
                f"steps={t.get('steps')} total={t.get('prompt_token_total')} "
                f"tool_res={t.get('tool_res')} clean={t.get('assert_clean')}"
            )
        return 0

    # T3c: broker concurrency header (heartbeat slots/queued) before the goals.
    heart = heartbeat_summary(read_broker_heartbeat())
    slots = heart["slots"]
    cap = heart["max_concurrent_goals"]
    if cap is None:
        cap = max_concurrent_goals()  # no beat yet: still show the effective cap
    slot_by_goal = {
        str(s.get("goal")): s.get("slot") for s in slots if s.get("goal")
    }

    goals = sorted(GOALS.glob("*.json")) if GOALS.is_dir() else []
    if args.json:
        rows = []
        for p in goals:
            try:
                g = json.loads(p.read_text(encoding="utf-8"))
                rows.append({
                    "goal": g.get("goal"),
                    "status": g.get("status"),
                    "slices": g.get("slices"),
                    "supervisor_ticket_count": g.get("supervisor_ticket_count"),
                    "prompt_token_total": (g.get("metrics") or {}).get("prompt_token_total"),
                    "limit_hit": g.get("limit_hit"),
                    "slot": slot_by_goal.get(str(g.get("goal") or p.stem)),
                })
            except (OSError, json.JSONDecodeError):
                pass
        print(json.dumps({"broker": heart, "goals": rows}, ensure_ascii=False, indent=2))
        return 0
    age = heart["heartbeat_age"]
    age_s = f"{age:.1f}s" if isinstance(age, (int, float)) else "-"
    pid_s = heart["pid"] if heart["pid"] is not None else "-"
    print(
        f"broker pid={pid_s} heartbeat_age={age_s} max_concurrent_goals={cap} "
        f"slots_busy={len(slots)}/{cap}"
    )
    for s in slots:
        print(
            f"slot={s.get('slot')} goal={s.get('goal')} phase={s.get('phase')} "
            f"ticket={s.get('ticket')} cwd={s.get('cwd')} since={s.get('started_at')}"
        )
    print(f"queued count={len(heart['queued'])}")
    for q in heart["queued"]:
        print(f"queued name={q.get('name')} reason={q.get('reason')}")
    print(f"goals_dir={GOALS} count={len(goals)}")
    for p in goals:
        try:
            g = json.loads(p.read_text(encoding="utf-8"))
            slot = slot_by_goal.get(str(g.get("goal") or p.stem))
            slot_s = f" slot={slot}" if slot is not None else ""
            print(
                f"- {g.get('goal')}: status={g.get('status')} slices={len(g.get('slices') or [])} "
                f"sup_tickets={g.get('supervisor_ticket_count')} "
                f"tokens={(g.get('metrics') or {}).get('prompt_token_total')} "
                f"hit={g.get('limit_hit') and (g.get('limit_hit') or {}).get('limit')}{slot_s}"
            )
        except (OSError, json.JSONDecodeError) as e:
            print(f"- {p.name}: read error {e}")
    return 0


def cmd_report(args: argparse.Namespace) -> int:
    _ensure_trial_lib()
    from trial_lib import aggregate_report, format_report_zh  # noqa: E402

    rep = aggregate_report(since=args.since)
    if args.json:
        print(json.dumps(rep, ensure_ascii=False, indent=2))
    else:
        print(format_report_zh(rep), end="")
    return 0


def cmd_limits(args: argparse.Namespace) -> int:
    _ensure_trial_lib()
    from trial_lib import (  # noqa: E402
        DEFAULT_LIMITS,
        LIMITS_PATH,
        load_global_limits,
        now_iso,
        save_global_limits,
    )

    if args.limits_action == "show":
        data = load_global_limits()
        if args.json:
            print(json.dumps({"path": str(LIMITS_PATH), "limits": data}, ensure_ascii=False, indent=2))
        else:
            print(f"path={LIMITS_PATH}")
            for k, v in data.items():
                print(f"  {k}={v}")
        return 0
    if args.limits_action == "set":
        data = load_global_limits()
        changed = {}
        for k in DEFAULT_LIMITS:
            val = getattr(args, k, None)
            if val is not None:
                data[k] = type(DEFAULT_LIMITS[k])(val)
                changed[k] = data[k]
        if not changed:
            print("nothing to set; pass e.g. --max-slices 5", file=sys.stderr)
            return 2
        save_global_limits(data)
        print(json.dumps({"updated": changed, "at": now_iso()}, ensure_ascii=False))
        return 0
    print("usage: dsh-trial limits show|set", file=sys.stderr)
    return 2


def _run_broker_script(script_name: str, extra: list[str] | None = None) -> int:
    root = broker_dir()
    script = root / script_name
    if not script.is_file():
        print(f"missing {script} (set DSH_TRIAL_ROOT to the dsh-trial checkout)", file=sys.stderr)
        return 2
    cmd = [str(script), *(extra or [])]
    return subprocess.call(cmd)


def cmd_start(args: argparse.Namespace) -> int:
    return _run_broker_script("start.sh", list(args.passthrough or []))


def cmd_stop(args: argparse.Namespace) -> int:
    return _run_broker_script("stop.sh", list(args.passthrough or []))


def cmd_broker_status(args: argparse.Namespace) -> int:
    root = broker_dir()
    py = root / "trial-broker.py"
    if not py.is_file():
        print(f"missing {py} (set DSH_TRIAL_ROOT)", file=sys.stderr)
        return 2
    return subprocess.call([sys.executable, str(py), "--status"])


def _add_goal_status_parser(sub: argparse._SubParsersAction, name: str, help_text: str) -> None:
    st = sub.add_parser(name, help=help_text)
    st.add_argument("goal", nargs="?", help="goal id")
    st.add_argument("--json", action="store_true")
    st.set_defaults(func=cmd_status)


def main() -> int:
    ap = argparse.ArgumentParser(prog="dsh-trial", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    start_p = sub.add_parser(
        "start",
        help="start broker-dsh-trial daemon (wraps broker/start.sh; never prod)",
        description="Wraps broker/start.sh. Extra flags (e.g. --once) are passed through. Never touches broker-khub-prod.",
    )
    start_p.set_defaults(func=cmd_start, passthrough=[])

    stop_p = sub.add_parser(
        "stop",
        help="stop broker-dsh-trial daemon (wraps broker/stop.sh; never prod)",
    )
    stop_p.set_defaults(func=cmd_stop, passthrough=[])

    bs = sub.add_parser(
        "broker-status",
        help="pid/inbox/chains (python3 broker/trial-broker.py --status)",
    )
    bs.set_defaults(func=cmd_broker_status)

    _add_goal_status_parser(
        sub, "status", "list goals or show one (thin-state; no goal → broker concurrency)"
    )
    _add_goal_status_parser(sub, "goals", "alias for status (list/show goals)")

    rp = sub.add_parser("report", help="cross-goal aggregate report (+ 并发 from heartbeat)")
    rp.add_argument("--since", help="ISO timestamp lower bound on goal created_at")
    rp.add_argument("--json", action="store_true")
    rp.set_defaults(func=cmd_report)

    lim = sub.add_parser("limits", help="show/set global trial limits")
    lim.add_argument("limits_action", choices=["show", "set"])
    lim.add_argument("--json", action="store_true")
    lim.add_argument("--max-slices", dest="max_slices", type=int)
    lim.add_argument("--max-supervisor-tickets", dest="max_supervisor_tickets", type=int)
    lim.add_argument("--max-rounds", dest="max_rounds", type=int)
    lim.add_argument("--ask-supervisor-timeout-sec", dest="ask_supervisor_timeout_sec", type=int)
    lim.add_argument("--ask-supervisor-poll-ms", dest="ask_supervisor_poll_ms", type=int)
    lim.add_argument("--prompt-timeout-sec", dest="prompt_timeout_sec", type=int)
    lim.set_defaults(func=cmd_limits)

    args, unknown = ap.parse_known_args()
    if args.cmd in ("start", "stop"):
        extra = list(unknown)
        if extra[:1] == ["--"]:
            extra = extra[1:]
        args.passthrough = extra
        return args.func(args)
    if unknown:
        ap.error("unrecognized arguments: " + " ".join(unknown))
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
