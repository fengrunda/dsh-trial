{
  "name": "dsh-step-budget-reminder",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Step-budget: soft nudges at 1x/1.5x; hard tool-block at 2x forcing paused_limit summary (G1).",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./budget": "./lib/budget.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "test",
    "README.zh.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/budget.js && node --check lib/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "license": "MIT"
}
